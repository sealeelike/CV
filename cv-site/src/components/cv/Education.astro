---
interface EducationItem {
  institution: string;
  degree: string;
  field?: string;
  startDate: string;
  endDate?: string;
  highlights?: string[];
}

interface Props {
  items: EducationItem[];
  sectionTitle?: string;
  requestDocument?: string;
}

const { items, sectionTitle = 'Education', requestDocument = 'Request Document' } = Astro.props;
---

<section class="cv-section cv-education">
  <h2 class="cv-section-title">{sectionTitle}</h2>
  {items.map((item) => (
    <div class="cv-item">
      <div class="cv-item-header">
        <div>
          <span class="cv-item-title">{item.degree}</span>
          {item.field && <span class="cv-item-subtitle">{item.field}</span>}
        </div>
        <span class="cv-item-date">
          {item.endDate ? `${item.startDate} — ${item.endDate}` : item.startDate}
        </span>
      </div>
      <div class="cv-item-subtitle">{item.institution}</div>
      {item.highlights && item.highlights.length > 0 && (
        <ul class="cv-item-highlights">
          {item.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )}
      {item.showRequestLink && (
        <div class="cv-item-actions">
          <a href="/request">{requestDocument} <span class="arrow">&nearr;</span></a>
        </div>
      )}
    </div>
  ))}
</section>
