---
interface EducationItem {
  institution: string;
  degree: string;
  field?: string;
  startDate: string;
  endDate?: string;
  highlights?: string[];
}

interface Props {
  items: EducationItem[];
}

const { items } = Astro.props;
---

<section class="cv-section cv-education">
  <h2 class="cv-section-title">Education</h2>
  {items.map((item) => (
    <div class="cv-item">
      <div class="cv-item-header">
        <div>
          <span class="cv-item-title">{item.degree}</span>
          {item.field && <span class="cv-item-subtitle"> in {item.field}</span>}
        </div>
        <span class="cv-item-date">
          {item.startDate} — {item.endDate ?? 'Present'}
        </span>
      </div>
      <div class="cv-item-subtitle">{item.institution}</div>
      {item.highlights && item.highlights.length > 0 && (
        <ul class="cv-item-highlights">
          {item.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )}
      <div class="cv-item-actions">
        <a href="/request">Request Document <span class="arrow">&nearr;</span></a>
      </div>
    </div>
  ))}
</section>
