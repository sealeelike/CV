---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../lib/auth.ts';
import { getMessages } from '../../lib/db.ts';

const kv = env.KV as KVNamespace;
const db = env.DB as D1Database;

const isAuthed = await requireAdmin(Astro.request, kv);
if (!isAuthed) return Astro.redirect('/admin/login');

const messages = await getMessages(db, 50, 0);
---

<AdminLayout title="Messages - Admin">
  <div class="admin-card">
    <h2>Messages</h2>
    {messages.map((m) => (
      <div class={`message-item ${m.read ? '' : 'unread'}`} data-id={m.message_id}>
        <div class="message-header">
          <div>
            <strong>{m.name || 'Anonymous'}</strong>
            {m.email && <span class="message-email">{m.email}</span>}
            {!m.read && <span class="badge badge-info">New</span>}
          </div>
          <span class="message-time">{new Date(m.created_at).toLocaleString()}</span>
        </div>
        <div class="message-content">{m.content}</div>
        {!m.read && (
          <button class="btn btn-secondary mark-read" data-id={m.message_id}>Mark as Read</button>
        )}
      </div>
    ))}
    {messages.length === 0 && (
      <p style="color:var(--admin-text-secondary);text-align:center;padding:2rem;">No messages yet</p>
    )}
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.mark-read').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id;
      await fetch('/api/admin/messages', {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messageId: Number(id), read: true }),
      });
      location.reload();
    });
  });
</script>

<style>
  .message-item {
    padding: 1rem;
    border-bottom: 1px solid var(--admin-border);
  }
  .message-item.unread {
    background: #f0f7ff;
  }
  .message-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .message-email {
    font-size: 0.8rem;
    color: var(--admin-text-secondary);
    margin-left: 0.5rem;
  }
  .message-time {
    font-size: 0.8rem;
    color: var(--admin-text-secondary);
  }
  .message-content {
    font-size: 0.9rem;
    white-space: pre-wrap;
    margin-bottom: 0.5rem;
  }
</style>
