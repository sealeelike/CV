{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "cv-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// D1 Database
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cv-site-db",
			"database_id": "PASTE_YOUR_D1_ID_HERE"
		}
	],
	// R2 Bucket for PDF files and themes
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "cv-site-files"
		}
	],
	// KV Namespace for config and CV content
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "PASTE_YOUR_KV_ID_HERE"
		}
	]
}
